# Supabase 프로젝트 설정 > API 에서 확인
# 로컬: 이 파일을 .env.local 로 복사해서 채우기 / Vercel: Environment Variables 에 동일한 이름으로 등록
NEXT_PUBLIC_SUPABASE_URL=https://여기에_프로젝트_ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_여기에_키

# scripts/migrate-from-sheets.mjs 를 쓸 때만 필요해요. (secret key. NEXT_PUBLIC_ 로 절대 노출 금지)
SUPABASE_SECRET_KEY=sb_secret_여기에_키

# ── 카카오 로그인 ──
# 카카오 개발자 콘솔 > 앱 설정 > 앱 키 > REST API 키
NEXT_PUBLIC_KAKAO_REST_API_KEY=여기에_REST_API_키
# 제품 설정 > 카카오 로그인 > 보안 > Client Secret (사용함으로 켠 경우에만 필요)
KAKAO_CLIENT_SECRET=여기에_client_secret

# ── 미니게임 푸시 알림 ──
# 키 만들기: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=여기에_public_key
VAPID_PRIVATE_KEY=여기에_private_key
VAPID_SUBJECT=mailto:내메일@example.com

# /api/cron/tick 을 아무나 못 부르게 막는 값. 아무 긴 랜덤 문자열이면 돼요.
CRON_SECRET=여기에_긴_랜덤_문자열
